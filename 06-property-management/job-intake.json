{
  "name": "PM Template - Job Intake",
  "nodes": [
    {
      "name": "Poll Job Intake Inbox",
      "notes": "NO CREDENTIAL ATTACHED YET - create/attach the client's job-intake inbox Gmail OAuth2 credential before activating. Polling, not push - practical latency ~1-2 min on n8n Cloud, same pattern as gmail-reply-handling.json's 'Poll Inbox for Replies'. This is the Phase 1 test path Gemini suggested: a mock email like 'Hi, I live at 10 Downing Street. My boiler is broken. Please call me on 07123456789' should flow through to a clean Airtable job card.",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        -144
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "filters": {
          "readStatus": "unread"
        }
      }
    },
    {
      "name": "Map Gmail Fields",
      "notes": "Gmail Trigger's simplified header/body field names (From, Subject, text/snippet) assumed - verify against a real received email, same caveat as gmail-reply-handling.json's equivalent node. tenant_name/phone/address left blank here - the Job Analysis Agent downstream extracts them from raw_message_text since email is unstructured.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        272,
        -144
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "g1",
              "name": "tenant_email",
              "type": "string",
              "value": "={{ ((($json.From || '').match(/<(.+)>/) || [null, $json.From])[1] || '').toLowerCase().trim() }}"
            },
            {
              "id": "g2",
              "name": "raw_message_text",
              "type": "string",
              "value": "={{ $json.text || $json.snippet || '' }}"
            },
            {
              "id": "g3",
              "name": "email_subject",
              "type": "string",
              "value": "={{ $json.Subject }}"
            },
            {
              "id": "g4",
              "name": "tenant_name",
              "type": "string",
              "value": ""
            },
            {
              "id": "g5",
              "name": "tenant_phone",
              "type": "string",
              "value": ""
            },
            {
              "id": "g6",
              "name": "property_address",
              "type": "string",
              "value": ""
            },
            {
              "id": "g7",
              "name": "source",
              "type": "string",
              "value": "Email"
            },
            {
              "id": "g8",
              "name": "submitted_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Tally Form Webhook (Fixflo Stand-in)",
      "notes": "Stands in for Fixflo's future webhook until their sandbox/API access arrives (request already sent - see Phase 1.5 in the plan). Build a Tally form with fields: Tenant Name, Tenant Email, Tenant Phone, Property Address, Issue Description (textarea) - point Tally's Webhook integration at this node's Production URL. Payload lands under $json.body.* (n8n wraps webhook POST bodies), same as tally-lead-intake.json and calcom-meeting-sync.json in this repo.",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "onError": "continueRegularOutput",
      "position": [
        0,
        304
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "pm-tally-intake",
        "options": {}
      }
    },
    {
      "name": "Map Tally Fields",
      "notes": "Field-matching by Tally field type (INPUT_EMAIL/INPUT_PHONE_NUMBER/TEXTAREA) with label-substring fallback, same approach as tally-lead-intake.json's 'Map Tally Fields' node. Tally already gives structured fields, so tenant_name/phone/address are set directly here rather than left for AI extraction.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        272,
        304
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "tenant_email",
              "type": "string",
              "value": "={{ ((($json.body.data.fields || []).find(f => f.type === 'INPUT_EMAIL') || {}).value || '').toString().toLowerCase().trim() || null }}"
            },
            {
              "id": "t2",
              "name": "tenant_name",
              "type": "string",
              "value": "={{ (($json.body.data.fields || []).find(f => (f.label||'').toLowerCase().includes('name')) || {}).value || null }}"
            },
            {
              "id": "t3",
              "name": "tenant_phone",
              "type": "string",
              "value": "={{ (($json.body.data.fields || []).find(f => f.type === 'INPUT_PHONE_NUMBER' || (f.label||'').toLowerCase().includes('phone')) || {}).value || null }}"
            },
            {
              "id": "t4",
              "name": "property_address",
              "type": "string",
              "value": "={{ (($json.body.data.fields || []).find(f => (f.label||'').toLowerCase().includes('address')) || {}).value || null }}"
            },
            {
              "id": "t5",
              "name": "raw_message_text",
              "type": "string",
              "value": "={{ (($json.body.data.fields || []).find(f => f.type === 'TEXTAREA') || ($json.body.data.fields || []).find(f => (f.label||'').toLowerCase().includes('issue') || (f.label||'').toLowerCase().includes('problem')) || {}).value || null }}"
            },
            {
              "id": "t6",
              "name": "source",
              "type": "string",
              "value": "Tally (Fixflo Stand-in)"
            },
            {
              "id": "t7",
              "name": "submitted_at",
              "type": "string",
              "value": "={{ ($json.body.data && $json.body.data.createdAt) || $now.toISO() }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Normalize Job Data",
      "notes": "Convergence point after shape-specific mapping (Map Gmail Fields / Map Tally Fields), mirroring tally-lead-intake.json's 'Normalize Lead Data' pattern. Source-agnostic by design so adding Fixflo later (Phase 1.5) needs no changes downstream of this node.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        528,
        80
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "n1",
              "name": "tenant_name",
              "type": "string",
              "value": "={{ $json.tenant_name || null }}"
            },
            {
              "id": "n2",
              "name": "tenant_email",
              "type": "string",
              "value": "={{ $json.tenant_email }}"
            },
            {
              "id": "n3",
              "name": "tenant_phone",
              "type": "string",
              "value": "={{ $json.tenant_phone || null }}"
            },
            {
              "id": "n4",
              "name": "property_address",
              "type": "string",
              "value": "={{ $json.property_address || null }}"
            },
            {
              "id": "n5",
              "name": "raw_message_text",
              "type": "string",
              "value": "={{ $json.raw_message_text || '' }}"
            },
            {
              "id": "n6",
              "name": "source",
              "type": "string",
              "value": "={{ $json.source }}"
            },
            {
              "id": "n7",
              "name": "submitted_at",
              "type": "string",
              "value": "={{ $json.submitted_at }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Has Required Fields?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        784,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.tenant_email}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{$json.tenant_email}}",
              "rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Log Invalid Submission",
      "notes": "Terminal: no job card created - submission lacked even a valid tenant email. Matches tally-lead-intake.json's 'Log Invalid Submission' pattern.",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1040,
