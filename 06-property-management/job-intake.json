          "value": "tblXXXXXXXXXXXXXX"
        },
        "filterByFormula": "={{ \"AND({Property Address} = '\" + (($('Job Analysis Agent').item.json.output && $('Job Analysis Agent').item.json.output.property_address) || $('Normalize Job Data').item.json.property_address || '') + \"', NOT(OR({Status} = 'Paid', {Status} = 'Archived')), IS_AFTER({Created Time}, DATEADD(NOW(), -14, 'days')))\" }}",
