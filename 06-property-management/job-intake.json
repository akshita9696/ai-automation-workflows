    },
    {
      "name": "Job Analysis Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1072,
        224
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\"tenant_name\",\"tenant_phone\",\"property_address\",\"issue_description\",\"priority\",\"confidence\",\"needs_manual_review\",\"review_reason\"],\n  \"properties\": {\n    \"tenant_name\": {\"type\": [\"string\",\"null\"]},\n    \"tenant_phone\": {\"type\": [\"string\",\"null\"]},\n    \"property_address\": {\"type\": [\"string\",\"null\"]},\n    \"issue_description\": {\"type\": [\"string\",\"null\"]},\n    \"priority\": {\"type\": \"string\", \"enum\": [\"Standard\",\"Urgent\",\"Emergency\"]},\n    \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1},\n    \"needs_manual_review\": {\"type\": \"boolean\"},\n    \"review_reason\": {\"type\": \"string\"}\n  }\n}"
      }
    },
