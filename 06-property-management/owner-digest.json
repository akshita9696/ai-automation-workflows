{
  "name": "PM Template - Owner Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "triggerAtDayOfMonth": 1,
              "triggerAtHour": 8
            }
          ]
        }
      },
      "name": "Monthly Owner Digest",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "notes": "Monthly (1st, 8am) proposed default - a 5-10 engineer shop's per-owner job volume is likely too low for a weekly digest to avoid feeling mostly-empty."
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "table": {
          "mode": "id",
          "value": "tblXXXXXXXXXXXXXX"
        },
        "filterByFormula": "={{ \"NOT({Status} = 'Archived')\" }}",
        "options": {}
      },
      "name": "Search All Active Jobs",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        272,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Zero active jobs is a legitimate 'no digest needed this month' case."
    },
    {
      "parameters": {
        "fieldsToSplitBy": "fields.Property Owner Email",
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "count",
              "field": "fields.Job ID"
            }
          ]
        },
        "options": {}
      },
      "name": "Summarize by Owner",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        528,
        0
      ],
      "notes": "Groups jobs into one item per distinct Property Owner Email. Exact output field naming unverified live."
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split In Batches - Owners",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        784,
        0
      ],
      "notes": "Output 0 (done) fires once all owners are processed; output 1 (loop) feeds the per-owner chain, which loops back into this node."
    },
    {
      "parameters": {},
      "name": "Digest Run Complete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1040,
        -160
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "table": {
          "mode": "id",
          "value": "tblXXXXXXXXXXXXXX"
        },
        "filterByFormula": "={{ \"AND(NOT({Status} = 'Archived'), {Property Owner Email} = '\" + ($json['fields.Property Owner Email'] || $json['Property Owner Email']) + \"')\" }}",
        "options": {}
      },
      "name": "Search Owner Job Details",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        1040,
        0
      ],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Reads the grouped owner-email field from Summarize's output - exact key name unverified, expression checks both a dotted and bare key defensively."
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "jobs",
        "include": "allFields",
        "options": {}
      },
      "name": "Aggregate Owner Jobs",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1296,
        0
      ],
      "notes": "Combines all of this owner's job rows into a single item's 'jobs' array."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "db1",
              "name": "owner_email",
              "type": "string",
              "value": "={{ $json.jobs[0].fields['Property Owner Email'] }}"
            },
            {
              "id": "db2",
              "name": "owner_name",
              "type": "string",
              "value": "={{ $json.jobs[0].fields['Property Owner Name'] }}"
            },
            {
              "id": "db3",
              "name": "overdue_count",
              "type": "number",
              "value": "={{ $json.jobs.filter(j => j.fields['Payment Reminder Tier'] && j.fields['Payment Reminder Tier'] !== 'None').length }}"
            },
            {
              "id": "db4",
              "name": "digest_body",
              "type": "string",
              "value": "={{ $json.jobs.map(j => '- ' + (j.fields['Property Address'] || 'Unknown address') + ': ' + (j.fields['Status'] || '') + (j.fields['Invoice Amount'] ? (', invoice GBP ' + j.fields['Invoice Amount'] + ' due ' + (j.fields['Invoice Due Date'] || 'N/A')) : '') + (j.fields['Priority'] === 'Emergency' ? ' [EMERGENCY]' : '')).join('\\n') }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Build Digest Email Body",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1552,
        0
      ],
      "notes": "overdue_count uses Payment Reminder Tier as a simple proxy for 'needs attention'."
    },
    {
      "parameters": {
        "sendTo": "={{$json.owner_email}}",
        "subject": "=Your monthly property update",
        "message": "=Hi {{$json.owner_name}},\n\nHere's your monthly summary:\n\n{{$json.digest_body}}\n\n{{$json.overdue_count > 0 ? ($json.overdue_count + ' item(s) may need your attention above.') : 'Everything looks on track.'}}\n\nThank you.",
        "options": {}
      },
      "name": "Email Owner - Monthly Digest",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1808,
        0
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Monthly Owner Digest": {
      "main": [
        [
          {
            "node": "Search All Active Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search All Active Jobs": {
      "main": [
        [
          {
            "node": "Summarize by Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize by Owner": {
      "main": [
        [
          {
            "node": "Split In Batches - Owners",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split In Batches - Owners": {
      "main": [
        [
          {
            "node": "Digest Run Complete",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Search Owner Job Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search Owner Job Details": {
      "main": [
        [
          {
            "node": "Aggregate Owner Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Owner Jobs": {
      "main": [
        [
          {
            "node": "Build Digest Email Body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Digest Email Body": {
      "main": [
        [
          {
            "node": "Email Owner - Monthly Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Owner - Monthly Digest": {
      "main": [
        [
          {
            "node": "Split In Batches - Owners",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}