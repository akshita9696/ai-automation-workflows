            {
              "id": "t1",
              "name": "tier_to_send",
              "type": "string",
              "value": "={{ $json.days_past_due >= $('Reminder Tier Thresholds (Days)').item.json.final_days && $('Merge Jobs with Invoice Status').item.json.fields['Payment Reminder Tier'] !== 'Final' ? 'Final' : ($json.days_past_due >= $('Reminder Tier Thresholds (Days)').item.json.firm_days && !['Firm','Final'].includes($('Merge Jobs with Invoice Status').item.json.fields['Payment Reminder Tier']) ? 'Firm' : ($json.days_past_due >= $('Reminder Tier Thresholds (Days)').item.json.friendly_days && !['Friendly','Firm','Final'].includes($('Merge Jobs with Invoice Status').item.json.fields['Payment Reminder Tier']) ? 'Friendly' : 'None')) }}"
