          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.InvoiceID || ($json.invoices && $json.invoices[0] && $json.invoices[0].InvoiceID) }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
