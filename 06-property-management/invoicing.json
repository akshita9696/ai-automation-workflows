{
  "name": "PM Template - Invoicing",
  "nodes": [
    {
      "name": "Watch for Job Complete",
      "notes": "Polling only, 30 min interval - less time-critical than Booking's link-send (15 min). Requires 'Last Modified Time' to be a real Last Modified Time field type.",
      "type": "n8n-nodes-base.airtableTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 30,
              "unit": "minutes"
            }
          ]
        },
        "authentication": "airtableTokenApi",
        "baseId": {
          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "tableId": {
          "mode": "id",
          "value": "tblXXXXXXXXXXXXXX"
        },
        "triggerField": "Last Modified Time",
        "additionalFields": {
          "formula": "{Status} = 'Job Complete'"
        }
      }
    },
    {
      "name": "Already Invoiced?",
      "notes": "Idempotency guard: a Job Complete row could get re-touched and re-fire this trigger. Skip rather than create a duplicate invoice.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        272,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.fields['Xero Invoice ID'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Already Invoiced - Skip",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        528,
        128
      ],
      "parameters": {}
    },
    {
      "name": "Required Fields for Invoicing?",
      "notes": "Never invoice with a fabricated amount or missing recipient.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        528,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.fields['Property Owner Email'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.fields['Job Price (Net, GBP)'] }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Flag Missing Invoice Fields",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        784,
        -160
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "table": {
          "mode": "id",
          "value": "tblXXXXXXXXXXXXXX"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "id"
          ],
          "schema": [],
          "value": {
            "id": "={{$json.id}}",
            "Needs Review": true,
            "Review Reason": "Missing Property Owner Email or Job Price (Net, GBP) - cannot invoice"
          }
        },
        "options": {}
      }
    },
    {
      "name": "Notify Coordinator - Invoice Blocked",
      "notes": "PLACEHOLDER_COORDINATOR_EMAIL - fill in before activating.",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "onError": "continueRegularOutput",
      "position": [
        1040,
        -160
      ],
      "parameters": {
        "sendTo": "you@example.com",
        "subject": "=Job needs review before invoicing: {{$('Watch for Job Complete').item.json.fields['Property Address']}}",
        "message": "=Job ID {{$('Watch for Job Complete').item.json.fields['Job ID']}} at {{$('Watch for Job Complete').item.json.fields['Property Address']}} reached Job Complete but is missing the Property Owner Email or Job Price. Please fill in the missing field(s).",
        "options": {}
      }
    },
    {
      "name": "Owner Xero Contact Cached?",
      "notes": "Avoids a redundant Xero Contact search once resolved once.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        784,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.fields['Owner Xero Contact ID'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Search Owner Xero Contact",
      "notes": "alwaysOutputData=true required. 'where' filter shape unverified against a live call - check before first real test.",
      "type": "n8n-nodes-base.xero",
      "typeVersion": 1,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        1040,
        80
      ],
      "parameters": {
        "resource": "contact",
        "operation": "getAll",
        "organizationId": "YOUR_XERO_TENANT_ID",
        "options": {
          "where": "=EmailAddress==\"{{ $json.fields['Property Owner Email'] }}\""
        }
      }
    },
    {
      "name": "Owner Contact Found?",
      "notes": "Exact response shape unverified until tested live - expression checks both shapes defensively.",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1296,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.ContactID || ($json.contacts && $json.contacts[0] && $json.contacts[0].ContactID) }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Create Owner Xero Contact",
      "notes": "Email address on the created Contact unverified - may need additionalFields collection.",
      "type": "n8n-nodes-base.xero",
      "typeVersion": 1,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        1552,
        176
      ],
      "parameters": {
        "resource": "contact",
        "organizationId": "YOUR_XERO_TENANT_ID",
        "name": "={{$('Watch for Job Complete').item.json.fields['Property Owner Name']}}",
        "additionalFields": {}
      }
    },
    {
      "name": "Cache Owner Contact ID",
      "notes": "Fed by both found and created paths.",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        1808,
        80
      ],
      "parameters": {
        "operation": "update",
        "base": {
          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "table": {
          "mode": "id",
          "value": "tblXXXXXXXXXXXXXX"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "id"
          ],
          "schema": [],
          "value": {
            "id": "={{$('Watch for Job Complete').item.json.id}}",
            "Owner Xero Contact ID": "={{$json.ContactID || ($json.contacts && $json.contacts[0] && $json.contacts[0].ContactID)}}"
          }
        },
        "options": {
          "typecast": true
        }
      }
    },
    {
      "name": "Payment Terms (Days)",
      "notes": "Tunable constant. Net 14 days is a sensible default, not a confirmed contractual fact - confirm against real client terms before go-live.",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2064,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pt1",
              "name": "payment_term_days",
              "type": "number",
              "value": 14
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Create Sales Invoice",
      "notes": "Account code 200, lineItemsUi shape, and taxType OUTPUT2 confirmed working against a live create call (2026-07-25). status:AUTHORISED required for AmountDue tracking.",
      "type": "n8n-nodes-base.xero",
      "typeVersion": 1,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "position": [
        2320,
        0
      ],
      "parameters": {
        "organizationId": "YOUR_XERO_TENANT_ID",
        "type": "ACCREC",
        "contactId": "={{$('Watch for Job Complete').item.json.fields['Owner Xero Contact ID'] || $('Cache Owner Contact ID').item.json.fields['Owner Xero Contact ID']}}",
        "lineItemsUi": {
          "lineItemsValues": [
            {
              "description": "={{$('Watch for Job Complete').item.json.fields['Issue Description'] || ('Repair job at ' + $('Watch for Job Complete').item.json.fields['Property Address'])}}",
              "unitAmount": "={{$('Watch for Job Complete').item.json.fields['Job Price (Net, GBP)']}}",
              "accountCode": "200",
              "taxType": "OUTPUT2"
            }
          ]
        },
        "additionalFields": {
          "date": "={{$now.toISODate()}}",
          "dueDate": "={{$now.plus({ days: $json.payment_term_days }).toISODate()}}",
          "reference": "=Job {{$('Watch for Job Complete').item.json.fields['Job ID']}} - {{$('Watch for Job Complete').item.json.fields['Property Address']}}",
          "status": "AUTHORISED"
        }
      }
    },
    {
      "name": "Invoice Created OK?",
