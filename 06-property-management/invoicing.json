      "typeVersion": 2.2,
      "onError": "continueRegularOutput",
      "position": [
        3088,
        -96
      ],
      "parameters": {
        "sendTo": "={{$('Watch for Job Complete').item.json.fields['Property Owner Email']}}",
        "subject": "=Invoice for your property at {{$('Watch for Job Complete').item.json.fields['Property Address']}}",
        "message": "=Hi {{$('Watch for Job Complete').item.json.fields['Property Owner Name']}},\n\nThe repair job at {{$('Watch for Job Complete').item.json.fields['Property Address']}} is complete. An invoice for GBP {{$('Watch for Job Complete').item.json.fields['Job Price (Net, GBP)']}} has been issued and is due on {{$now.plus({ days: $('Payment Terms (Days)').item.json.payment_term_days }).toISODate()}}.\n\nThank you.",
        "options": {}
      }
