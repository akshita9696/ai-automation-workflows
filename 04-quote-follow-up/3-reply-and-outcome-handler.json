        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $('Find a Matching Live Quote').item.json['Owner Email'] || 'you@example.com' }}",
        "subject": "=Quote reply: {{ $('Find a Matching Live Quote').item.json['Client Name'] }} - {{ $('Did They Ask to Stop?').item.json.intent }}",
        "emailType": "text",
        "message": "={{ $('Find a Matching Live Quote').item.json['Client Name'] }} has replied about \"{{ $('Find a Matching Live Quote').item.json['Quote Description'] }}\" ({{ $('Find a Matching Live Quote').item.json['Quote Value'] }}).\n\nHow it reads: {{ $('Did They Ask to Stop?').item.json.intent }}\nIn one line: {{ $('Did They Ask to Stop?').item.json.summary }}\n\nWhat they wrote:\n{{ $('Normalize the Reply').item.json.reply_text }}\n\nReply to them at: {{ $('Normalize the Reply').item.json.from_email }}\n\nThe automatic chasing for this quote has stopped. Mark it Won or Lost in the register when you know which it is.",
        "options": {}
      }
    }
  ],
