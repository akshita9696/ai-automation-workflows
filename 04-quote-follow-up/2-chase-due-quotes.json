            "Last Touch At": "={{ $now.toFormat('yyyy-MM-dd') }}",
            "Next Chase Due": "={{ $('Pick Chase Angle').item.json.is_final ? '' : $now.plus({ days: $('Pick Chase Angle').item.json.next_interval_days }).toFormat('yyyy-MM-dd') }}",
            "Last Message Sent": "={{ $('Use AI Copy').isExecuted ? $('Use AI Copy').item.json.body : $('Use Fallback Copy').item.json.body }}"
          },
          "matchingColumns": [
            "id"
          ],
          "schema": []
