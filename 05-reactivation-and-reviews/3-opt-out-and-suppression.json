      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "you@example.com",
        "subject": "=URGENT: opt-out request was NOT recorded",
        "emailType": "text",
        "message": "=Somebody asked to be left alone and it could NOT be written to the suppression list. They may be contacted again.\n\nAddress: {{ $('Normalize the Message').item.json.from_email }}\nWhat they wrote: {{ $('Normalize the Message').item.json.reply_text }}\n\nWhat Airtable said: {{ JSON.stringify($json.error || $json) }}\n\nAdd them to the suppression list by hand now. This is the one failure in the system worth stopping what you are doing for.",
        "options": {}
      }
    },
    {
      "name": "Are They a Known Customer?",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "alwaysOutputData": true,
      "retryOnFail": true,
