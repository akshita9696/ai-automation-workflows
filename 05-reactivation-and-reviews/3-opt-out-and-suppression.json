      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "you@example.com",
        "subject": "=Opted out: {{ $('Normalize the Message').item.json.from_email }}",
        "emailType": "text",
        "message": "={{ $('Normalize the Message').item.json.from_email }} has asked not to be contacted again and has been suppressed.\n\nThey will not receive reactivation messages or review requests from now on.\n\nHow it was spotted: {{ $('Add to the Suppression List').item.json.Reason || 'see suppression list' }}\n\nWhat they wrote:\n{{ $('Normalize the Message').item.json.reply_text }}\n\nThis is permanent. If they ever ask to come back, clear the flag on their record by hand.",
        "options": {}
      }
    }
