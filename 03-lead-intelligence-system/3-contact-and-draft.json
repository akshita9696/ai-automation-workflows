        "modelName": "models/gemini-3.7-flash",
        "options": {}
      },
      "name": "Google Gemini Chat Model (Draft)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        880,
        320
      ],
      "notes": "CREDENTIAL: select or create \"Google Gemini API\" here, left blank on purpose, n8n's API auto-attaches an unrelated existing credential of the same type if one is provided by name only."
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"subject\",\n    \"body\"\n  ],\n  \"properties\": {\n    \"subject\": {\n      \"type\": \"string\",\n      \"description\": \"Short, specific, plain-English subject line. No hype words.\"\n    },\n    \"body\": {\n      \"type\": \"string\",\n      \"description\": \"The full email body, first person singular, ending with a permission-based CTA.\"\n    }\n  }\n}"
      },
      "name": "Draft Email Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1088,
        320
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Business: {{$json.fields['Business Name']}}\nOwner name (use if present, else address the business generally): {{$json.fields['Owner Name'] || '(not found - do not invent one)'}}\nDetected problem: {{$json.fields['Detected Problem']}}\nExact evidence quote to reference: {{$json.fields['Evidence Quote']}}\nWhat I would offer them: {{$json.fields['What To Sell Them']}}\n\nWHAT BREAKS AND WHAT IT COSTS THEM (my own internal analysis - rewrite this in your own plain words, never paste it verbatim, and never state a figure it does not contain):\n{{$json.fields['What Breaks First'] || '(none recorded)'}}\n\nWrite the first outreach email to this business and produce the required structured JSON output.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You write the first cold outreach email for a solo AI automation consultant (never \"we\", always \"I\", there is no team). The business has zero paying clients yet, so never invent a client result, a testimonial, or a number that isn't true. Never claim a compliance certification.\n\nRules for every email:\n- Reference the evidence given, this is what makes it personal, not a template. But NEVER put it in quotation marks and NEVER attribute it to them. The evidence field usually contains MY OWN analytical observation, not words they wrote. Presenting it as a quote puts words in their mouth that they never said, which destroys trust the moment they notice. Write \"you offer downloadable patient forms, so someone is re-typing that into your system\", never \"I noticed on your site that '...'\" followed by the evidence verbatim. Only ever quote text that is unmistakably a customer review, and even then attribute it to the reviewer, never to the business.\n- One offer only. Never a menu of services.\n- Plain English, short sentences, understated tone. Specific beats impressive.\n- Never use these words/phrases: leverage, synergy, cutting-edge, revolutionary, game-changer, unlock the power of, supercharge, seamless, \"in today's fast-paced world\", \"I hope this email finds you well\", circle back, touch base.\n- The call to action must be permission-based, e.g. \"worth me sending over a 90-second video showing exactly what I mean?\", never \"book a call\" or a scheduling link.\n- If owner name was not found, address the business by name, do not guess or invent a name.\n- Keep the body under 120 words.\n\nRespond only with the required JSON output."
        }
      },
      "name": "Draft Email",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        992,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 60000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
