      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "you@example.com",
        "subject": "=Call needs a callback: {{ $('Prepare Call Record').item.json.caller_phone }}",
        "emailType": "text",
        "message": "=A call to the AI receptionist needs a human.\n\nCaller: {{ $('Prepare Call Record').item.json.caller_phone }}\nWhat happened: {{ $json.one_line_summary }}\nWhy you're getting this: {{ $json.escalation_reason }}\nOutcome: {{ $json.outcome }}\nCall ended because: {{ $('Prepare Call Record').item.json.ended_reason }}\nLength: {{ $('Prepare Call Record').item.json.duration_seconds }} seconds\n\nTranscript:\n{{ $('Prepare Call Record').item.json.transcript }}",
        "options": {}
      }
    },
