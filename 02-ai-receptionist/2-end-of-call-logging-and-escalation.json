              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "e3",
              "leftValue": "={{ $('Prepare Call Record').item.json.ended_reason }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ]
        },
        "looseTypeValidation": true
      }
    },
    {
