      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "position": [
        1960,
