    {
      "name": "Google Gemini Chat Model (Classify Call)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "retryOnFail": false,
      "position": [
        760,
        420
      ],
      "parameters": {
        "modelName": "models/gemini-3-flash-preview",
        "options": {}
      }
    },
    {
      "name": "Call Outcome Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        960,
        420
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"outcome\": {\n      \"type\": \"string\",\n      \"description\": \"One of: Booked, Rescheduled, Cancelled, Message Taken, Escalated, Abandoned, Unclear\"\n    },\n    \"needs_human_followup\": {\n      \"type\": \"string\",\n      \"description\": \"The word true or the word false. true if a person must call this caller back.\"\n    },\n    \"escalation_reason\": {\n      \"type\": \"string\",\n      \"description\": \"Short reason a human is needed, or the word none\"\n    },\n    \"one_line_summary\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence describing what the caller wanted and what happened\"\n    }\n  },\n  \"required\": [\"outcome\", \"needs_human_followup\", \"escalation_reason\", \"one_line_summary\"]\n}"
      }
    },
    {
      "name": "Classify Call Outcome",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 20000,
      "onError": "continueRegularOutput",
      "position": [
        820,
        220
      ],
      "parameters": {
        "promptType": "define",
        "text": "=A call to an HVAC company's AI receptionist just ended. Decide what happened.\n\nHow the call ended (system reason): {{ $json.ended_reason }}\nCall length in seconds: {{ $json.duration_seconds }}\n\nTranscript:\n{{ $json.transcript }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You review finished phone calls for an HVAC company that uses an AI receptionist. You classify what happened. You never invent detail that isn't in the transcript.\n\nPick the outcome that actually happened:\n- Booked: an appointment was confirmed to the caller\n- Rescheduled: an existing appointment was moved\n- Cancelled: an existing appointment was cancelled\n- Message Taken: the AI took a message for a human\n- Escalated: the caller asked for a person, or was transferred\n- Abandoned: the caller hung up before anything was resolved\n- Unclear: the transcript is empty, broken, or you genuinely cannot tell\n\nSet needs_human_followup to the word true when: the caller wanted something the AI could not finish, asked for a person, sounded angry or was complaining, the booking failed, or the call ended badly (an error, or a hang-up mid-request). Otherwise set it to the word false.\n\nKeep escalation_reason under 15 words. Write none when no follow-up is needed.\nKeep one_line_summary factual and under 25 words."
        }
      }
    },
    {
      "name": "AI Classify OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1120,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.output.outcome }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true
      }
    },
    {
