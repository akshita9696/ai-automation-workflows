    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "email",
              "type": "string",
              "value": "={{ ((($json.body.data.fields || []).find(f => f.type === 'INPUT_EMAIL') || ($json.body.data.fields || []).find(f => (f.label||'').toLowerCase().includes('email')) || {}).value || '').toString().toLowerCase().trim() || null }}"
            },
            {
              "id": "a2",
              "name": "full_name",
              "type": "string",
              "value": "={{ ((($json.body.data.fields || []).find(f => f.type !== 'DROPDOWN' && f.type !== 'INPUT_EMAIL' && (f.label||'').toLowerCase().includes('name')) || {}).value) || ((($json.body.data.fields || []).find(f => f.type === 'INPUT_EMAIL') || {}).value || '').split('@')[0] || 'there' }}"
            },
            {
              "id": "a3",
              "name": "company_size",
              "type": "string",
              "value": "={{ (() => { const fields = $json.body.data.fields || []; const f = fields.find(fx => fx.type === 'DROPDOWN' && /company|team|size|people|employee/i.test(fx.label||'')); if (!f) return null; const sel = (f.options||[]).filter(o => (f.value||[]).includes(o.id)).map(o => o.text); return sel.length ? sel.join(', ') : (f.value||[]).join(', '); })() }}"
            },
            {
              "id": "a4",
              "name": "budget",
              "type": "string",
              "value": "={{ (() => { const fields = $json.body.data.fields || []; const f = fields.find(fx => fx.type === 'DROPDOWN' && /budget|price|spend|invest/i.test(fx.label||'')); if (!f) return null; const sel = (f.options||[]).filter(o => (f.value||[]).includes(o.id)).map(o => o.text); return sel.length ? sel.join(', ') : (f.value||[]).join(', '); })() }}"
            },
            {
              "id": "a5",
              "name": "problem_description",
              "type": "string",
              "value": "={{ (() => { const fields = $json.body.data.fields || []; const f = fields.find(fx => fx.type === 'TEXTAREA') || fields.find(fx => /problem|help|task|challenge|need|describe|automat/i.test(fx.label||'')); return f ? f.value : null; })() }}"
            },
            {
              "id": "a6",
