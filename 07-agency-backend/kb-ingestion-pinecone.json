{
  "name": "KB Ingestion - Pinecone (Agency)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "mode": "id",
          "value": "YOUR_GOOGLE_DRIVE_FOLDER_ID"
        },
        "event": "fileCreated",
        "options": {}
      },
      "name": "New File in KB Folder",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "notes": "Watches the 'Knowledge Base Inbox' Drive folder. Swap PLACEHOLDER_KB_FOLDER_ID for the real folder ID and attach Google Drive OAuth2 credential before activating."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.mimeType}}",
              "rightValue": "application/pdf",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Is PDF?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        272,
        0
      ]
    },
    {
      "parameters": {},
      "name": "Skip Non-PDF File",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        272,
        256
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "mode": "id",
          "value": "={{$json.id}}"
        },
        "options": {}
      },
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        608,
        -16
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Attach Google Drive OAuth2 credential before activating."
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {
          "mode": "id",
          "value": "agency-kb"
        },
        "options": {}
      },
      "name": "Insert into KB Index",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [
        896,
        -16
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Swap PLACEHOLDER_PINECONE_INDEX_NAME for the real index name and attach Pinecone API credential before activating."
    },
    {
      "parameters": {
        "chunkOverlap": 150,
        "options": {}
      },
      "name": "Chunk Document",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        1040,
        288
      ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "specificField",
        "loader": "pdfLoader",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source_file_name",
                "value": "={{$('Download File').item.json.name}}"
              },
              {
                "name": "source_file_id",
                "value": "={{$('Download File').item.json.id}}"
              },
              {
                "name": "ingested_at",
                "value": "={{$now.toISO()}}"
              }
            ]
          }
        }
      },
      "name": "Document Loader (PDF)",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        976,
        144
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "name": "OpenAI Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [
        784,
        144
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "Attach OpenAI API credential before activating."
    }
  ],
  "connections": {
    "New File in KB Folder": {
      "main": [
        [
          {
            "node": "Is PDF?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is PDF?": {
      "main": [
        [
          {
            "node": "Download File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Non-PDF File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download File": {
      "main": [
        [
          {
            "node": "Insert into KB Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chunk Document": {
      "ai_textSplitter": [
        [
          {
            "node": "Document Loader (PDF)",
            "type": "ai_textSplitter",
            "index": 0
          }
        ]
      ]
    },
    "Document Loader (PDF)": {
      "ai_document": [
        [
          {
            "node": "Insert into KB Index",
            "type": "ai_document",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Embeddings": {
      "ai_embedding": [
        [
          {
            "node": "Insert into KB Index",
            "type": "ai_embedding",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}